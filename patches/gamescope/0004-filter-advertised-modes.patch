+// Keep mode selection and the advertised list consistent. Zero fields in the
+// existing blocklist are wildcards, including refresh rate.
+static bool is_blocklisted_mode( const drmModeModeInfo *mode )
+{
+	for ( const auto &badMode : g_badModes )
+	{
+		if ( ( badMode.width   == 0 || mode->hdisplay == badMode.width ) &&
+		     ( badMode.height  == 0 || mode->vdisplay == badMode.height ) &&
+		     ( badMode.refresh == 0 || mode->vrefresh == badMode.refresh ) )
+			return true;
+	}
+	return false;
+}
