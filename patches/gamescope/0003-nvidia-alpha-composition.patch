+	// Blending a layer that carries alpha on a hardware plane corrupts the picture on
+	// nvidia-drm, so those frames are composited instead. This is decided from the
+	// display device that was actually opened, never from the render GPU, so a hybrid
+	// system with an NVIDIA render GPU behind another display controller is unaffected.
+	// On a device that is positively identified the policy is on;
+	// GAMESCOPE_NVIDIA_COMPOSITE_ALPHA=0 opts out of this reason alone and 1 asks for
+	// it explicitly. It cannot be turned on for any other driver.
+	{
+		std::optional<bool> oRequested;
+		const char *pszRequest = getenv( "GAMESCOPE_NVIDIA_COMPOSITE_ALPHA" );
+		if ( pszRequest && *pszRequest )
+		{
+			if ( !strcmp( pszRequest, "0" ) )
+				oRequested = false;
+			else if ( !strcmp( pszRequest, "1" ) )
+				oRequested = true;
+			else
+				drm_log.warnf( "GAMESCOPE_NVIDIA_COMPOSITE_ALPHA is '%s', which is neither 0 nor 1. Using the default.", pszRequest );
+		}
+
+		drmVersionPtr pVersion = drmGetVersion( drm->fd );
+		const char *pszDriver = ( pVersion && pVersion->name && *pVersion->name ) ? pVersion->name : nullptr;
+		const bool bNvidiaDisplay = pszDriver && !strcmp( pszDriver, "nvidia-drm" );
+		drm->bCompositeNvidiaAlphaLayers = bNvidiaDisplay && oRequested.value_or( true );
+
+		if ( !pszDriver )
+		{
+			drm_log.warnf( "Could not identify the driver of the display device. Presentation behaviour is unchanged and the NVIDIA alpha layer composition policy is NOT active." );
+		}
+		else
+		{
+			drm_log.infof( "Display device driver: %s", pszDriver );
+			if ( !bNvidiaDisplay )
+				drm_log.infof( "NVIDIA alpha layer composition policy: not applicable to %s", pszDriver );
+			else if ( drm->bCompositeNvidiaAlphaLayers )
+				drm_log.infof( "NVIDIA alpha layer composition policy: enabled%s", oRequested ? " by GAMESCOPE_NVIDIA_COMPOSITE_ALPHA=1" : " by default for nvidia-drm" );
+			else
+				drm_log.infof( "NVIDIA alpha layer composition policy: disabled by GAMESCOPE_NVIDIA_COMPOSITE_ALPHA=0. Every other reason to composite still applies." );
+		}
+
+		if ( pVersion )
+			drmFreeVersion( pVersion );
+	}
+
 	if (drmGetCap(drm->fd, DRM_CAP_CURSOR_WIDTH, &drm->cursor_width) != 0) {
 		drm->cursor_width = 64;
 	}
