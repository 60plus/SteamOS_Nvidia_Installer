#!/bin/bash
# Read-only report. Optional tools may be absent on recovery images.
set -u
export LC_ALL=C
probe() {
  printf '\n[%s]\n' "$1"
  shift
  if command -v "$1" >/dev/null 2>&1; then
    timeout 15 "$@" 2>&1 || printf 'Unavailable or command failed (status %s).\n' "$?"
  else
    printf 'Not installed: %s\n' "$1"
  fi
}
printf 'SteamOS NVIDIA diagnostics\n'
printf 'Review the report before sharing. Hardware identifiers and log messages may be present.\n'
probe 'Installed integration version' cat /usr/lib/steamos-nvidia/integration-version.json
probe 'Configured installer update source (next check, not installation origin)' python3 -I - <<'SOURCE_SUMMARY'
import json
from pathlib import Path
import runpy
import stat
from urllib.parse import urlsplit

def summary():
    path = Path('/usr/lib/steamos-nvidia/installer-update-source.json')
    try:
        info = path.lstat()
        # Match the installed updater's source-file ownership and permission rule.
        if stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            print('Configuration: rejected by updater (symlink, not root-owned, or writable by others)')
            return
        with path.open('rb') as stream:
            raw = stream.read(65537)
    except FileNotFoundError:
        print('Configuration: missing')
        return
    except OSError:
        print('Configuration: unreadable')
        return
    try:
        if len(raw) > 65536:
            raise ValueError('oversized')
        cfg = json.loads(raw)
    except (ValueError, UnicodeError, RecursionError):
        print('Configuration: invalid')
        return
    try:
        # Reuse the installed updater's schema without running its command-line entry point.
        updater = runpy.run_path('/usr/lib/steamos-nvidia/installer-update.py')
        validate = updater['validate_source']
        current_api, legacy = updater['RELEASE_API'], updater['LEGACY_SOURCE']
    except Exception:
        print('Configuration: present; validation unavailable (updater could not be loaded)')
        return
    try:
        cfg = validate(cfg)
        api, origin = urlsplit(cfg['release_api']), urlsplit(cfg['download_origin'])
        # Validate ports before printing anything derived from the configuration.
        api.port, origin.port
    except (ValueError, TypeError, AttributeError, KeyError, UnicodeError, RecursionError):
        # Exception messages and raw values may contain credentials or tokens.
        print('Configuration: invalid')
        return
    print('Configuration: present (signing key and connectivity not checked)')
    if cfg['release_api'] == current_api and cfg['download_origin'] == legacy['download_origin']:
        print('Endpoint: official GitHub repository 60plus/SteamOS_Nvidia_Installer')
    elif cfg['release_api'] == legacy['release_api'] and cfg['download_origin'] == legacy['download_origin']:
        print('Endpoint: legacy official GitHub repository 60plus/steamos-nvidia-installer (before 0.2.2)')
    else:
        print('Endpoint: custom')
        # Even a syntactically valid path or display name can contain a secret.
        print('Release server: https://' + api.netloc + ' (path omitted)')
        print('Download server: https://' + origin.netloc)
    print('Prereleases: ' + ('enabled' if cfg['allow_prerelease'] else 'disabled'))

summary()
SOURCE_SUMMARY
probe 'Original image build' cat /usr/lib/steamos-nvidia/build-info.txt
probe 'Last installed versions' cat /usr/lib/steamos-nvidia/runtime-info.txt
probe 'Steam HDR preference' python3 /usr/lib/steamos-nvidia/hdr-defaults.py --status
probe 'CPU' lscpu
probe 'System' cat /etc/os-release
probe 'Kernel' uname -r
probe 'Graphics, network and audio devices' lspci -nnk
probe 'Driver' nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv
probe 'Loaded modules' lsmod
probe 'Kernel command line' cat /proc/cmdline
probe 'NVIDIA module parameters' cat /sys/module/nvidia_drm/parameters/modeset /sys/module/nvidia_drm/parameters/fbdev
probe 'xpadneo' modinfo hid_xpadneo
probe 'Display connectors' sh -c 'for f in /sys/class/drm/card*-*/status; do [ -f "$f" ] && printf "%s: %s\n" "$f" "$(cat "$f")"; done'
probe 'Display modes' sh -c 'for f in /sys/class/drm/card*-*/modes; do [ -f "$f" ] && { printf "%s:\n" "$f"; cat "$f"; }; done'
probe 'Desktop display configuration' kscreen-doctor -o
probe 'Gamescope version in the distribution package' /usr/bin/gamescope --version
probe 'Session type' printenv XDG_SESSION_TYPE
probe 'Audio devices' wpctl status
probe 'Bluetooth controllers' bluetoothctl list
probe 'USB devices and Bluetooth adapters' lsusb
probe 'Radio blocks' rfkill list
probe 'Bluetooth configuration' cat /etc/bluetooth/main.conf /etc/bluetooth/input.conf
probe 'Bluetooth service' systemctl --no-pager status bluetooth.service
probe 'Free space' df -h / /home /tmp
probe 'Partition sizes' lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINTS
probe 'System Btrfs allocation' btrfs filesystem usage /
probe 'Booted slot' steamos-bootconf this-image
probe 'Last completed patch' cat /usr/lib/steamos-nvidia/complete
probe 'NVIDIA power services' systemctl is-enabled nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service
probe 'Recent update log' tail -n 100 /var/log/steamos-nvidia-repatch.log
probe 'Current boot errors' journalctl -b -p err --no-pager -n 100

probe "Safe Graphics" steamos-nvidia-safe-graphics status

probe 'Bluetooth audio resume' systemctl --user --no-pager status steamos-nvidia-bluetooth-resume.service
probe 'Bluetooth audio resume log' journalctl --user -b -u steamos-nvidia-bluetooth-resume.service --no-pager -n 40

probe 'Root filesystem and slot source' findmnt -no SOURCE,FSTYPE,OPTIONS /
probe 'Installed NVIDIA package' pacman -Q nvidia-utils
probe 'NVIDIA module on disk' modinfo -F version nvidia
probe 'Loaded NVIDIA module' cat /sys/module/nvidia/version
probe 'Installed addon files (does not test runtime behavior)' bash -c 'source /usr/lib/steamos-nvidia/pc-support.sh && pc_check_addons /'
probe 'Effective HDR startup hook' systemctl --user cat steam-launcher.service
probe 'Effective graphics session' systemctl --user cat gamescope-session.service
probe 'Effective Bluetooth audio resume service' systemctl --user cat steamos-nvidia-bluetooth-resume.service

probe 'Last NVIDIA userspace dependency check (recorded during build or repair)' cat /usr/lib/steamos-nvidia/userspace-check.txt

probe 'Gamescope selection recorded for this system (not necessarily what is running)' cat /usr/lib/steamos-nvidia/gamescope/status.txt
probe 'Gamescope build actually running' sh -c '
  found=0
  for pid in $(pgrep -x gamescope-wl 2>/dev/null) $(pgrep -x gamescope 2>/dev/null); do
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || continue
    case "$exe" in
      /usr/lib/steamos-nvidia/gamescope/bin/gamescope*) origin="this project build" ;;
      /usr/bin/gamescope*) origin="distribution package" ;;
      *) origin="neither of the known locations" ;;
    esac
    printf "pid %s: %s (%s)\n" "$pid" "$exe" "$origin"
    found=1
  done
  [ "$found" = 1 ] || printf "No Gamescope process found, so nothing is in use right now. The line above records a selection, not a running build. Note the process is named gamescope-wl.\n"
'
probe 'Gamescope version the running session reported at startup' sh -c 'journalctl --user -u gamescope-session -b --no-pager 2>/dev/null | grep -m1 -i "gamescope version" || printf "No startup version line in this boot. Game Mode may not have started in this boot, or the journal is unavailable to this user.\n"'
probe 'Game Mode executable search path' systemctl --user show gamescope-session.service -p Environment
